{
  "name": "taxi-shift",
  "version": "1.0.0",
  "description": "An offline arcade taxi driving and racing game.",
  "main": "desktop/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/server.mjs",
    "build": "node scripts/build-release-docs.mjs && node scripts/build.mjs",
    "assets": "node scripts/create-store-assets.mjs",
    "desktop": "electron .",
    "desktop:build": "npm run build && electron-builder --win --config electron-builder.json",
    "android:sync": "npm run build && cap sync android",
    "android:tools": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-android-tools.ps1",
    "android:key": "node scripts/create-upload-key.mjs",
    "android:build": "npm run android:sync && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "test": "node --test tests/*.test.mjs",
    "test:web": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.56.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  }
}
